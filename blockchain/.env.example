# Alchemy or Infura Sepolia RPC URL
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Example: https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY"

# Deployer wallet private key (Exported from MetaMask - NEVER commit real keys!)
PRIVATE_KEY="your_wallet_private_key_without_quotes_or_with_0x"

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY="your_etherscan_api_key"
