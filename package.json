{
  "name": "landblock-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Decentralized Land Registry System Monorepo",
  "scripts": {
    "blockchain:install": "npm --prefix blockchain install",
    "blockchain:compile": "npm --prefix blockchain run compile",
    "blockchain:node": "npm --prefix blockchain run node",
    "blockchain:deploy:local": "npm --prefix blockchain run deploy:local",
    "blockchain:deploy:sepolia": "npm --prefix blockchain run deploy:sepolia",
    "blockchain:seed": "npm --prefix blockchain run seed",
    "blockchain:test": "npm --prefix blockchain test",
    "backend:install": "npm --prefix backend install",
    "backend:start": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "backend:test": "npm --prefix backend test",
    "backend:test:integration": "npm --prefix backend run test:integration",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test:all": "npm --prefix blockchain test && npm --prefix backend test && npm --prefix backend run test:integration"
  }
}
